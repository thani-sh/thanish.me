{
  "name": "@thani-sh/blog",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build:watch": "nodemon --exec 'npm run build' -w ./src",
    "build": "npm run clean && node ./builder.js",
    "clean": "rm -rf build/*",
    "dev": "npm run build:watch & npm run serve",
    "lint": "prettier -w .src/**/*.{js,jsx,md,mdx}",
    "serve": "serve ./build"
  },
  "devDependencies": {
    "@mdx-js/esbuild": "^3.1.0",
    "@mdx-js/mdx": "^3.1.0",
    "esbuild": "^0.25.3",
    "glob": "^11.0.2",
    "handlebars": "^4.7.8",
    "nodemon": "^3.1.10",
    "pixi.js": "^6.5.10",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-highlight": "^7.0.2",
    "serve": "^14.2.4"
  },
  "packageManager": "yarn@4.9.1"
}
